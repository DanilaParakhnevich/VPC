# JWT signing secret. Must be used at user-service (as /auth) and at the gateway-service validating itself
JWT_SECRET=5367566859703373367639792F423F452848284D6251655468576D5A71347437

# Kafka addresses
KAFKA_PORT=9092

#Redis addresses
REDIS_PORT=6379

#############################################################################
# GATEWAY SERVICE — API Gateway with authorization and authentication
#############################################################################

# Port the gateway listens on
GATEWAY_SERVICE_SERVER_PORT=8080
GATEWAY_SERVICE_DEBUGGER_PORT=5005

# Log level
GATEWAY_LOG_LEVEL=DEBUG

# Actuator user
GATEWAY_ACTUATOR_USER=admin

# Admin password
GATEWAY_ACTUATOR_PASSWORD=admin123

#############################################################################
# USERS SERVICE — keeping all users info
#############################################################################

# Ports
USER_SERVICE_DEBUGGER_PORT=5006
USER_SERVICE_SERVER_PORT=8082
USER_SERVICE_DATABASE_PORT=5432

# DB name
USERS_DB_NAME=users

# DB user
USERS_DB_USER=postgres

# DB Password
USERS_DB_PASSWORD=1234

# Show SQL in logs
USERS_SHOW_SQL=false

# Log level
USERS_LOG_LEVEL=DEBUG

# Actuator user
USERS_ACTUATOR_USER=admin

# Actuator password
USERS_ACTUATOR_PASSWORD=admin123

